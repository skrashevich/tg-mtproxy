# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Твой Telegram ID (узнать: @userinfobot)
ADMIN_ID=123456789

# IP адрес VDS сервера (используется для дефолтного сервера, если нет servers.json)
SERVER_IP=123.45.67.89

# Порт MTProto proxy (используется для дефолтного сервера, если нет servers.json)
PROXY_PORT=443

# Имя docker-контейнера с MTProto proxy (используется для дефолтного сервера)
PROXY_CONTAINER=mtproxy

# Глобальный лимит пользователей (суммарно по всем серверам)
MAX_USERS=50
SOFT_LIMIT=40

# Мониторинг RAM (процент)
RAM_WARN_PERCENT=80
RAM_STOP_PERCENT=90

# Бесплатный триал (0 = выключен)
TRIAL_DAYS=1
TRIAL_MAX_CONNECTIONS=1

# Уведомлять админа о выдаче триала (1 = да, 0 = нет)
TRIAL_NOTIFY_ADMIN=1

# FakeTLS домен для маскировки трафика под HTTPS (используется для дефолтного сервера)
# Трафик прокси будет выглядеть как обычный HTTPS к указанному домену
# Оставьте пустым для обычного dd-режима (random padding)
FAKE_TLS_DOMAIN=

# ─── Оплата ───
# Способ по умолчанию: stars (переключается через /set_payment в боте)
# CryptoBot (https://t.me/CryptoBot)
CRYPTOBOT_TOKEN=
# CryptoCloud (https://cryptocloud.plus)
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=

# ─── Мультисерверная конфигурация ───
# Серверы настраиваются через файл data/servers.json
# Если файл не существует, он автоматически создаётся из SERVER_IP/PROXY_PORT/PROXY_CONTAINER
# Пример файла: data/servers.example.json
